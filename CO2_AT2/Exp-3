# Q3: Morphology-Based Normalization

words = ["govern", "government", "governance"]

print("-" * 95)
print("{:<15} {:<15} {:<15} {:<20} {:<15}".format(
    "Original", "Root", "Affix", "Derivational Level", "Normalized"))
print("-" * 95)

for word in words:

    if word == "govern":
        root = "govern"
        affix = "-"
        level = "Level 0"

    elif word == "government":
        root = "govern"
        affix = "-ment"
        level = "Level 1"

    elif word == "governance":
        root = "govern"
        affix = "-ance"
        level = "Level 1"

    print("{:<15} {:<15} {:<15} {:<20} {:<15}".format(
        word, root, affix, level, root))
